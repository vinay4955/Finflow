# FinFlow Kafka Stack — Environment Variables
# Copy this file to .env and adjust if needed.
# .env is gitignored; commit only .env.example
#
# Every variable below is referenced by docker-compose.yml. If you add one here,
# wire it up there too — an unreferenced variable is worse than no variable,
# because it implies a change point that does not exist.

# KRaft cluster ID — 22-char base64 (generated once, never change it).
# Changing this on an existing cluster makes the brokers refuse to start against
# their existing log dirs. Regenerate only alongside `docker-compose down -v`.
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Host ports for external Kafka access (from your laptop / host machine).
# Each broker advertises PLAINTEXT_EXTERNAL://localhost:<its port>, so changing
# a value here changes the published port, the listener and the advertised
# address together. Change these if something else on your machine holds them.
BROKER_1_PORT=9092
BROKER_2_PORT=9094
BROKER_3_PORT=9095

# Host port for the Kafka UI web interface
KAFKA_UI_PORT=8080

# NOTE: broker node IDs (1, 2, 3) are intentionally NOT configurable here.
# They are structural — each broker needs a fixed identity and the KRaft quorum
# string in docker-compose.yml hardcodes all three. A node ID is not a setting.
