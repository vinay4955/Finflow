# FinFlow Kafka Stack — Environment Variables
# Copy this file to .env and adjust if needed.
# .env is gitignored; commit only .env.example

# Kafka broker ID (must be unique per broker in a multi-node setup)
KAFKA_NODE_ID=1

# KRaft cluster ID — must be exactly 22 chars base64 (generated once, never change)
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Host port for external Kafka access (from your laptop / host machine)
KAFKA_EXTERNAL_PORT=9092

# Host port for Kafka UI web interface
KAFKA_UI_PORT=8080
